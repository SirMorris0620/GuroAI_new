rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for User
    function isValidUser() {
      let data = incoming();
      return data.keys().hasAll(['email', 'createdAt']) && data.keys().size() == 2 &&
             data.email is string && data.email.size() <= 256 &&
             data.createdAt is timestamp;
    }

    // Validation for HistoryItem
    function isValidHistoryItem(userId) {
      let data = incoming();
      let hasAdditional = data.keys().hasAll(['additionalInstructions']);
      let baseKeys = ['id', 'userId', 'topic', 'subject', 'grade', 'content', 'timestamp'];
      let keysValid = hasAdditional ? 
                      data.keys().hasAll(baseKeys) && data.keys().size() == 8 : 
                      data.keys().hasAll(baseKeys) && data.keys().size() == 7;
                      
      return keysValid &&
             data.id is string && data.id.size() <= 100 &&
             data.userId == userId &&
             data.topic is string && data.topic.size() <= 500 &&
             data.subject is string && data.subject.size() <= 100 &&
             data.grade is string && data.grade.size() <= 100 &&
             data.content is string && data.content.size() <= 100000 &&
             data.timestamp is number &&
             (!hasAdditional || (data.additionalInstructions is string && data.additionalInstructions.size() <= 2000));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser() && incoming().createdAt == request.time;
      allow update: if false; // Users shouldn't need to be updated right now
      allow delete: if false;

      match /lessons/{lessonId} {
        allow get: if isOwner(userId) && existing().userId == userId;
        allow list: if isOwner(userId) && resource.data.userId == userId;
        allow create: if isOwner(userId) && isValidHistoryItem(userId) && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false; // Lessons are immutable history
        allow delete: if isOwner(userId) && existing().userId == userId;
      }
    }
  }
}
